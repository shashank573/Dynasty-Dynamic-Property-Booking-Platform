# Copy this file to .env and provide your own local values.
SESSION_SECRET=replace-with-a-long-random-secret
MONGO_URL=mongodb://127.0.0.1:27017/DynaStay

# Required: create a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Defaults to OpenRouter's free-model router.
OPENROUTER_MODEL=openrouter/free
