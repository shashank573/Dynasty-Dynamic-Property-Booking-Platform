<% layout("layouts/boilerplate") %>
<div class="row justify-content-center my-4">
  <div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div><h1 class="h3 mb-1">Submit a complaint</h1><p class="text-muted mb-0">Tell our support team what happened.</p></div>
      <a class="btn btn-outline-secondary" href="/complaints/my">My complaints</a>
    </div>
    <div id="complaint-message" class="alert d-none" role="status" aria-live="polite"></div>
    <form id="complaint-form" class="card card-body shadow-sm" novalidate>
      <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <select class="form-select" id="category" name="category" required>
          <option value="">Choose a category</option>
          <% ["Booking", "Parking", "Property", "Host", "Guest", "Payment", "Safety", "Other"].forEach(category => { %>
            <option value="<%= category %>"><%= category %></option>
          <% }) %>
        </select>
      </div>
      <div class="mb-3"><label for="subject" class="form-label">Subject</label><input class="form-control" id="subject" name="subject" minlength="5" maxlength="120" required><div class="form-text">5–120 characters.</div></div>
      <div class="mb-3"><label for="description" class="form-label">Describe the issue</label><textarea class="form-control" id="description" name="description" rows="5" minlength="10" maxlength="3000" required></textarea><div class="form-text">10–3000 characters. Please avoid sharing passwords or payment-card details.</div></div>
      <div class="mb-3">
        <label for="bookingId" class="form-label">Related booking (optional)</label>
        <select class="form-select" id="bookingId" name="bookingId"><option value="">Not linked to a booking</option>
          <% bookings.forEach(booking => { %><option value="<%= booking._id %>">Booking <%= String(booking._id).slice(-8) %> · <%= new Date(booking.checkIn).toLocaleDateString() %> – <%= new Date(booking.checkOut).toLocaleDateString() %> · <%= booking.status %></option><% }) %>
        </select>
        <div class="form-text">Only bookings belonging to your account are listed.</div>
      </div>
      <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Submit complaint</button><a class="btn btn-light" href="/complaints/my">Cancel</a></div>
    </form>
  </div>
</div>
<script>
(() => {
  const form = document.getElementById("complaint-form");
  const message = document.getElementById("complaint-message");
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const button = form.querySelector('button[type="submit"]');
    button.disabled = true;
    message.className = "alert d-none";
    const values = Object.fromEntries(new FormData(form).entries());
    if (!values.bookingId) delete values.bookingId;
    try {
      const response = await fetch("/complaints", {
        method: "POST", headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify(values)
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.message || "Could not submit complaint.");
      window.location.assign("/complaints/my?submitted=1");
    } catch (error) {
      message.textContent = error.message || "Something went wrong. Please try again.";
      message.className = "alert alert-danger";
    } finally { button.disabled = false; }
  });
})();
</script>
