<% layout("layouts/boilerplate") %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 my-4">
  <div><h1 class="h3 mb-1">Complaint administration</h1><p class="text-muted mb-0">Review reports and follow the controlled status workflow.</p></div>
  <a class="btn btn-outline-secondary" href="/complaints/admin-dashboard">Clear filter</a>
</div>
<div class="btn-group flex-wrap mb-3" role="group" aria-label="Filter complaints by status">
  <a class="btn btn-outline-primary" href="/complaints/admin-dashboard">All</a>
  <% statuses.forEach(status => { %><a class="btn btn-outline-primary" href="/complaints/admin-dashboard?status=<%= encodeURIComponent(status) %>"><%= status %></a><% }) %>
</div>
<div id="admin-message" class="alert d-none" role="status" aria-live="polite"></div>
<% if (!complaints.length) { %><div class="alert alert-info">No complaints match this filter.</div><% } %>
<div class="row g-3 mb-4">
<% complaints.forEach(complaint => { %>
  <div class="col-12"><article class="card shadow-sm"><div class="card-body">
    <div class="d-flex flex-wrap justify-content-between gap-2"><div><span class="badge text-bg-light border"><%= complaint.category %></span><h2 class="h5 mt-2 mb-1"><%= complaint.subject %></h2><p class="small text-muted mb-0">Submitted <%= new Date(complaint.createdAt).toLocaleString() %> · <%= complaint.complainant ? complaint.complainant.name : "Deleted account" %><% if (complaint.complainant) { %> (<%= complaint.complainant.email %>)<% } %></p></div><span class="badge text-bg-secondary align-self-start"><%= complaint.status %></span></div>
    <p class="mt-3" style="white-space: pre-wrap"><%= complaint.description %></p>
    <% if (complaint.booking) { %><p class="small text-muted">Booking: <%= new Date(complaint.booking.checkIn).toLocaleDateString() %> – <%= new Date(complaint.booking.checkOut).toLocaleDateString() %> · <%= complaint.booking.status %></p><% } %>
    <form class="admin-status-form border rounded p-3 mb-3" data-id="<%= complaint._id %>">
      <h3 class="h6">Update status / internal note</h3>
      <label class="form-label" for="status-<%= complaint._id %>">Status</label>
      <select class="form-select mb-2" id="status-<%= complaint._id %>" name="status" required>
        <% statuses.forEach(status => { %><option value="<%= status %>" <%= complaint.status === status ? "selected" : "" %>><%= status %></option><% }) %>
      </select>
      <label class="form-label" for="note-<%= complaint._id %>">Private admin note</label>
      <textarea class="form-control mb-2" id="note-<%= complaint._id %>" name="adminNote" rows="2" maxlength="2000"><%= complaint.adminNote || "" %></textarea>
      <button class="btn btn-primary btn-sm" type="submit">Save update</button>
      <% if (complaint.handledAt) { %><small class="text-muted ms-2">Last handled <%= new Date(complaint.handledAt).toLocaleString() %><% if (complaint.handledBy) { %> by <%= complaint.handledBy.name %><% } %></small><% } %>
    </form>
    <% if (["Resolved", "Rejected"].includes(complaint.status)) { %>
      <form class="admin-reopen-form border rounded p-3" data-id="<%= complaint._id %>">
        <h3 class="h6">Reopen closed complaint</h3>
        <label class="form-label" for="reason-<%= complaint._id %>">Reason (10–1000 characters)</label>
        <textarea class="form-control mb-2" id="reason-<%= complaint._id %>" name="reason" rows="2" minlength="10" maxlength="1000" required></textarea>
        <button class="btn btn-outline-warning btn-sm" type="submit">Reopen for review</button>
        <% if (complaint.reopenHistory && complaint.reopenHistory.length) { %><p class="small text-muted mt-2 mb-0"><%= complaint.reopenHistory.length %> previous reopening event(s) recorded.</p><% } %>
      </form>
    <% } %>
  </div></article></div>
<% }) %>
</div>
<script>
(() => {
  const message = document.getElementById("admin-message");
  function showMessage(text, ok) {
    message.textContent = text;
    message.className = "alert " + (ok ? "alert-success" : "alert-danger");
  }
  async function send(url, body) {
    const response = await fetch(url, {
      method: "PATCH", headers: { "Content-Type": "application/json", "Accept": "application/json" },
      body: JSON.stringify(body)
    });
    const result = await response.json();
    if (!response.ok) throw new Error(result.message || "Update failed.");
    return result;
  }
  document.querySelectorAll(".admin-status-form").forEach(form => form.addEventListener("submit", async event => {
    event.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    button.disabled = true;
    try {
      const data = Object.fromEntries(new FormData(form).entries());
      const result = await send("/complaints/" + encodeURIComponent(form.dataset.id) + "/status", data);
      showMessage(result.message, true);
      window.location.reload();
    } catch (error) { showMessage(error.message, false); }
    finally { button.disabled = false; }
  }));
  document.querySelectorAll(".admin-reopen-form").forEach(form => form.addEventListener("submit", async event => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const button = form.querySelector('button[type="submit"]');
    button.disabled = true;
    try {
      const result = await send("/complaints/" + encodeURIComponent(form.dataset.id) + "/reopen", Object.fromEntries(new FormData(form).entries()));
      showMessage(result.message, true);
      window.location.reload();
    } catch (error) { showMessage(error.message, false); }
    finally { button.disabled = false; }
  }));
})();
</script>
