<% layout("/layouts/boilerplate") %>
<div class="container py-4">
  <a class="text-decoration-none" href="/listings/<%= listing._id %>">&larr; Back to property</a>
  <h1 class="mt-3">Manage inventory</h1><p class="text-muted"><%= listing.title %> · <%= listing.location %>, <%= listing.country %></p>
  <div id="inventory-message" class="mb-3" role="status" aria-live="polite"></div>
  <div class="row g-4">
    <div class="col-lg-6"><div class="card h-100"><div class="card-body">
      <h2 class="h4">Add a unit</h2>
      <form id="unit-form" class="row g-3">
        <div class="col-12"><label class="form-label" for="unit-name">Unit name</label><input class="form-control" id="unit-name" name="name" required maxlength="100" placeholder="Deluxe Room / Family Suite"></div>
        <div class="col-12"><label class="form-label" for="unit-description">Description</label><textarea class="form-control" id="unit-description" name="description" rows="2" maxlength="1000"></textarea></div>
        <div class="col-md-6"><label class="form-label" for="unit-capacity">Guest capacity</label><input class="form-control" id="unit-capacity" name="capacity" type="number" min="1" max="50" value="2" required></div>
        <div class="col-md-6"><label class="form-label" for="unit-price">Price per night (₹)</label><input class="form-control" id="unit-price" name="pricePerNight" type="number" min="0" step="1" required></div>
        <div class="col-12"><button class="btn btn-dark" type="submit">Add unit</button></div>
      </form>
    </div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-body">
      <h2 class="h4">Add parking slot</h2>
      <form id="parking-form" class="row g-3">
        <div class="col-12"><label class="form-label" for="slot-number">Slot number</label><input class="form-control" id="slot-number" name="slotNumber" required maxlength="30" placeholder="P-01"></div>
        <div class="col-md-6"><label class="form-label" for="slot-hour">Price per hour (₹)</label><input class="form-control" id="slot-hour" name="pricePerHour" type="number" min="0" step="1" value="0" required></div>
        <div class="col-md-6"><label class="form-label" for="slot-day">Price per day (₹)</label><input class="form-control" id="slot-day" name="pricePerDay" type="number" min="0" step="1" value="0" required></div>
        <div class="col-12"><button class="btn btn-dark" type="submit">Add parking slot</button></div>
      </form>
    </div></div></div>
  </div>
  <section class="mt-5"><h2 class="h4">Units (<%= units.length %>)</h2>
  <% if (units.length) { %><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Unit</th><th>Capacity</th><th>Nightly price</th><th>Availability</th><th>Action</th></tr></thead><tbody>
  <% units.forEach(unit => { %><tr><td><strong><%= unit.name %></strong><% if (unit.description) { %><div class="small text-muted"><%= unit.description %></div><% } %></td><td><%= unit.capacity %></td><td>₹<%= Number(unit.pricePerNight).toLocaleString("en-IN") %></td><td><span class="badge <%= unit.isAvailable ? 'text-bg-success' : 'text-bg-secondary' %>"><%= unit.isAvailable ? 'Available' : 'Disabled' %></span></td><td><button class="btn btn-sm btn-outline-secondary toggle-unit" data-id="<%= unit._id %>" data-available="<%= unit.isAvailable %>" data-name="<%= unit.name %>" data-description="<%= unit.description %>" data-capacity="<%= unit.capacity %>" data-price="<%= unit.pricePerNight %>"><%= unit.isAvailable ? 'Disable' : 'Enable' %></button></td></tr><% }) %>
  </tbody></table></div><% } else { %><p class="text-muted">No units yet. Add a unit above.</p><% } %></section>
  <section class="mt-4"><h2 class="h4">Parking slots (<%= parkingSlots.length %>)</h2>
  <% if (parkingSlots.length) { %><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Slot</th><th>Hourly</th><th>Daily</th><th>Status</th></tr></thead><tbody>
  <% parkingSlots.forEach(slot => { %><tr><td><%= slot.slotNumber %></td><td>₹<%= Number(slot.pricePerHour).toLocaleString("en-IN") %></td><td>₹<%= Number(slot.pricePerDay).toLocaleString("en-IN") %></td><td><span class="badge <%= slot.isActive ? 'text-bg-success' : 'text-bg-secondary' %>"><%= slot.isActive ? 'Active' : 'Inactive' %></span></td></tr><% }) %>
  </tbody></table></div><% } else { %><p class="text-muted">No parking slots yet. Add a slot above.</p><% } %></section>
</div>
<script>
(() => {
 const listingId = <%- JSON.stringify(listing._id.toString()) %>;
 const message = document.getElementById("inventory-message");
 async function request(url, options) {
   const response = await fetch(url, options);
   const data = await response.json().catch(() => ({}));
   if (!response.ok) throw new Error((data.error && (Array.isArray(data.error) ? data.error.join(", ") : data.error)) || data.message || "Request failed.");
   return data;
 }
 function showMessage(text, ok=true) { message.className = "alert " + (ok ? "alert-success" : "alert-danger"); message.textContent = text; }
 document.getElementById("unit-form").addEventListener("submit", async event => {
   event.preventDefault(); const f = event.currentTarget;
   const unit = { name:f.elements.name.value.trim(), description:f.elements.description.value.trim(), capacity:Number(f.elements.capacity.value), pricePerNight:Number(f.elements.pricePerNight.value), isAvailable:true };
   try { const data = await request("/listings/"+listingId+"/units", {method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({unit})}); showMessage(data.message); setTimeout(()=>location.reload(),350); } catch(error) { showMessage(error.message,false); }
 });
 document.getElementById("parking-form").addEventListener("submit", async event => {
   event.preventDefault(); const f = event.currentTarget;
   const body = {slotNumber:f.elements.slotNumber.value.trim(),pricePerHour:Number(f.elements.pricePerHour.value),pricePerDay:Number(f.elements.pricePerDay.value)};
   try { const data = await request("/parking/listings/"+listingId+"/slots", {method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)}); showMessage(data.message); setTimeout(()=>location.reload(),350); } catch(error) { showMessage(error.message,false); }
 });
 document.querySelectorAll(".toggle-unit").forEach(button => button.addEventListener("click", async () => {
   const unit = {name:button.dataset.name, description:button.dataset.description, capacity:Number(button.dataset.capacity), pricePerNight:Number(button.dataset.price), isAvailable:button.dataset.available !== "true"};
   try { const data = await request("/listings/"+listingId+"/units/"+button.dataset.id, {method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({unit})}); showMessage(data.message); setTimeout(()=>location.reload(),350); } catch(error) { showMessage(error.message,false); }
 }));
})();
</script>